PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=property_platform
# Change this to any long random text (16+ characters)
JWT_SECRET=change_this_to_a_long_random_text
JWT_EXPIRES_IN=7d
# Website address that may call this API (* = any, for testing only)
CORS_ORIGIN=*
# These users can edit or delete any property (comma separated emails)
ADMIN_EMAILS=harsha@example.com
# Folder for uploaded property images
UPLOAD_DIR=uploads
